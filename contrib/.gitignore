# Ignore everything by default, contrib sources are coming from other places
*

# Include specific files that should be tracked by Git
!.gitignore

# tracked contrib module: Wi-Fi 6/7/8 benchmark suite
!wifi-benchmarks/
!wifi-benchmarks/**

# tracked contrib module: Bluetooth Low Energy model
!ble/
!ble/**

# tracked contrib module: Ultra-Wideband model
!uwb/
!uwb/**
